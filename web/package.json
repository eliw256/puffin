{
  "name": "puffin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prototype": "vite --open /prototype.html",
    "dev": "vite",
    "build": "vite build && node scripts/stamp.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
